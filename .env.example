# Copy to .env.local and fill in to connect a real Supabase project.
# The app runs perfectly well with none of these set — it falls back to
# the in-memory seed data in lib/seed-data.ts. See README.md.

NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=

# QuickBooks Online Integration — see README "QuickBooks Online Integration"
QUICKBOOKS_CLIENT_ID=
QUICKBOOKS_CLIENT_SECRET=
QUICKBOOKS_REDIRECT_URI=
QUICKBOOKS_ENVIRONMENT=sandbox
QUICKBOOKS_WEBHOOK_VERIFIER_TOKEN=

# Google Places address autocomplete (New Client / Edit Client / New Building).
# Optional — without it the address boxes are plain text inputs.
NEXT_PUBLIC_GOOGLE_MAPS_API_KEY=

# Email intake (drawings / invoices forwarded from Gmail via Resend).
RESEND_API_KEY=
RESEND_WEBHOOK_SECRET=

# Sentry error monitoring — see docs/ai-bug-support/architecture-notes.md.
# Optional — without NEXT_PUBLIC_SENTRY_DSN, Sentry is entirely inert (no
# network calls, no overhead), same as every other integration above.
# DSN is public (safe in the client bundle); the auth token is a SECRET
# used only at build time to upload source maps — never ships to the browser.
NEXT_PUBLIC_SENTRY_DSN=
SENTRY_ORG=travers-group-llc
SENTRY_PROJECT=
SENTRY_AUTH_TOKEN=
