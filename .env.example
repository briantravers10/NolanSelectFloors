# Copy to .env.local and fill in to connect a real Supabase project.
# The app runs perfectly well with none of these set — it falls back to
# the in-memory seed data in lib/seed-data.ts. See README.md.

NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=

# QuickBooks Online Integration — see README "QuickBooks Online Integration"
QUICKBOOKS_CLIENT_ID=
QUICKBOOKS_CLIENT_SECRET=
QUICKBOOKS_REDIRECT_URI=
QUICKBOOKS_ENVIRONMENT=sandbox
QUICKBOOKS_WEBHOOK_VERIFIER_TOKEN=
